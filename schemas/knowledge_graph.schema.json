{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHRONOS Omega Knowledge Graph Record",
  "type": "object",
  "required": ["id", "kind", "label", "evidence_class", "source_ids"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["Person", "Civilization", "Generation", "Place", "Event", "Text", "Edition", "Concept", "ScientificDiscovery", "Institution", "Tradition", "Experiment", "Dataset", "Claim", "Source"]},
    "label": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "date_start": {"type": ["string", "null"], "format": "date"},
    "date_end": {"type": ["string", "null"], "format": "date"},
    "evidence_class": {"enum": ["empirical", "historical", "interpretive", "tradition", "hypothesis", "unsupported"]},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "properties": {"type": "object"}
  },
  "additionalProperties": false
}
